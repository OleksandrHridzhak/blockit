{
  "expo": {
    "name": "Blockit",
    "slug": "blockit",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/branding/blockit-mascot-land-sky-v4.png",
    "scheme": "blockit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/blockit-mascot-land-sky-v4.png",
      "bundleIdentifier": "com.hridzhak.blockit.2WT689Y795",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram",
          "tiktok",
          "snssdk1233",
          "youtube",
          "twitter",
          "fb",
          "reddit",
          "tg",
          "whatsapp",
          "snapchat",
          "pinterest",
          "linkedin",
          "threads",
          "barcelona"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "2WT689Y795",
      "buildNumber": "27"
    },
    "android": {
      "package": "com.hridzhak.blockit",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/blockit-mascot-land-sky-v4.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212"
        }
      ],
      "./plugins/withScreenTime"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "BlockitShield",
                  "bundleIdentifier": "com.hridzhak.blockit.2WT689Y795.BlockitShield",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.hridzhak.blockit.2WT689Y795"
                    ]
                  }
                },
                {
                  "targetName": "BlockitAction",
                  "bundleIdentifier": "com.hridzhak.blockit.2WT689Y795.BlockitAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.hridzhak.blockit.2WT689Y795"
                    ]
                  }
                },
                {
                  "targetName": "BlockitMonitor",
                  "bundleIdentifier": "com.hridzhak.blockit.2WT689Y795.BlockitMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.hridzhak.blockit.2WT689Y795"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "16649efa-f52d-4039-a184-d32a4c6f8004"
      }
    },
    "owner": "sasha72"
  }
}
